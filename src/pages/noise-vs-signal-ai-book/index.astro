---
import PageLayout from "@layouts/PageLayout.astro";
import Book3D from "@components/Book3D.astro";
import Signup from "@components/Signup.astro";
import Reviews from "@components/Reviews.astro";
import { BOOK } from "@consts";

// Verbatim from the "Remember" box that closes each chapter of the PDF.
const beats = [
  { ch: "Ch. 1", text: "The model is not answering your question; it is generating text shaped like an answer to your question." },
  { ch: "Ch. 3", text: "The model can only work with what is currently in front of it. Deciding what goes into that window is your actual craft." },
  { ch: "Ch. 4", text: "The model is only as effective as the data placed before it. Most of your impact is decided before you even open the tool." },
  { ch: "Ch. 6", text: "Treat AI like an intern with a photographic memory and zero personal stake in the outcome. Brief it accordingly." },
  { ch: "Ch. 9", text: "Jeff had tools; Steve had a process. Build the strategy before you buy the gear." },
];

const learn = [
  { text: "Understand the single thing a model is doing every time it answers you, and watch every strange result you have ever seen suddenly make sense.", ref: "Ch. 1" },
  { text: "Spot the confident invention, and learn the one habit that catches it every time.", ref: "Ch. 2" },
  { text: "Know why what you paste in matters far more than how you word the request.", ref: "Ch. 3" },
  { text: "Climb the data food chain that quietly decides how senior your work looks, before you ever open Figma.", ref: "Ch. 4" },
  { text: "Turn a pile nobody has read into a roadmap. Tickets, reviews, cancellation reasons, thousands of them, in days.", ref: "Ch. 4" },
  { text: "Reach the one level of listening to a user that AI cannot get to.", ref: "Ch. 5" },
  { text: "Avoid the four places AI quietly ruins design work: generated screens, critique, microcopy and accessibility.", ref: "Ch. 7" },
  { text: "Build the verification habit that came out of the night my own agent told me it had finished 113 files. It had finished 53.", ref: "Ch. 8" },
  { text: "Say out loud which parts of your job are safe, and why.", ref: "Ch. 6 & 9" },
  { text: "Run a model on your own machine when the data cannot leave the building.", ref: "Ch. 10 & 11" },
];

// Mirrors the Contents page of the PDF, with its real page numbers.
type TocEntry =
  | { kind: "front"; t: string; page: number }
  | { kind: "part"; n: number; t: string; page: number }
  | { kind: "chapter"; n: number; t: string; page: number };

const toc: TocEntry[] = [
  { kind: "front", t: "Before we start", page: 3 },
  { kind: "part", n: 1, t: "How it thinks", page: 7 },
  { kind: "chapter", n: 1, t: "It just predicts the next word", page: 8 },
  { kind: "chapter", n: 2, t: "Why it lies to your face", page: 11 },
  { kind: "chapter", n: 3, t: "What it can actually see", page: 13 },
  { kind: "part", n: 2, t: "How you work with it", page: 16 },
  { kind: "chapter", n: 4, t: "Garbage in, garbage out", page: 17 },
  { kind: "chapter", n: 5, t: "Listening is a skill (and AI doesn’t have it)", page: 19 },
  { kind: "chapter", n: 6, t: "What it’s great at, what it’s terrible at", page: 21 },
  { kind: "chapter", n: 7, t: "Pointing AI at the design itself", page: 23 },
  { kind: "part", n: 3, t: "Why it fails and how you plan around it", page: 25 },
  { kind: "chapter", n: 8, t: "The agent that lied to me", page: 26 },
  { kind: "chapter", n: 9, t: "Two architects in the desert", page: 29 },
  { kind: "part", n: 4, t: "Going independent", page: 32 },
  { kind: "chapter", n: 10, t: "Why you would want your own setup", page: 33 },
  { kind: "chapter", n: 11, t: "Running local AI: the practical guide", page: 35 },
  { kind: "front", t: "Conclusion: where this leaves you", page: 37 },
];

const faqs = [
  { q: "Is it really free?", a: "Yes. No card, no shipping fee, no trial, nothing hidden three pages in. You give an email address and the book arrives as a PDF." },
  { q: "Do I need to know how to code?", a: "No. If you can read a Figma file you can read this. The single technical chapter sits at the very end on purpose, and you can skip it entirely." },
  { q: "I use ChatGPT every day. Will this be too basic?", a: "The first three chapters will be partly familiar. Chapters four to eight are where daily users tend to find the gaps, particularly around what to feed it and how to check what comes back." },
  { q: "How long does it take to read?", a: "About an hour end to end. Chapter four takes ten minutes on its own and is the one that changes how you work." },
  { q: "What happens to my email address?", a: "You get the book, then roughly one email a week about using AI in real design work. Never shared, never sold, one click to leave." },
  { q: "Is this a pitch for something expensive?", a: "There is a paid course coming later. It is not built yet and you will not be nagged about it. If the free book is all you ever take from me, that is a fine outcome." },
];

const pad = (n: number) => String(n).padStart(2, "0");
const marqueeWords = Array.from({ length: 6 });
---

<PageLayout title={BOOK.TITLE} description={BOOK.DESCRIPTION} image={BOOK.IMAGE} theme="book">
  <!-- HERO -->
  <section class="hero" data-book-zone>
    <div class="wrap hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow eyebrow-dot">AI guide for UX &amp; product designers</p>
        <h1>
          Everyone is handing you rotten AI advice. <span class="soft">This is the one worth taking.</span>
        </h1>
        <p class="hero-sub">
          Eleven short chapters on what AI is really doing under the hood, written by a designer who
          ships with it. About an hour to read.
        </p>
        <div id="get" class="hero-signup">
          <Signup id="e1" source="hero" fine="Free, no card, no shipping. Arrives in about a minute." />
        </div>
      </div>

      <div class="hero-book">
        <div class="book-disc" aria-hidden="true"></div>
        <Book3D />
      </div>
    </div>
  </section>

  <!-- TWO PULL QUOTES -->
  <section class="quotes">
    <div class="wrap" data-reveal>
      <h2 class="quotes-title">From the book</h2>
      <div class="quotes-grid">
      <figure class="paper">
        <div class="slip">
          <figcaption>From chapter 2</figcaption>
          <blockquote>The model does not know when it does not know. Confidence tells you nothing about correctness.</blockquote>
          <p>on why AI invents sources in the tone it uses for facts</p>
        </div>
      </figure>
      <figure class="paper">
        <div class="slip">
          <figcaption>From chapter 5</figcaption>
          <blockquote>AI analyzes the problem you hand it. It will never ask whether that problem should exist in the first place.</blockquote>
          <p>on the one level of listening a machine cannot reach</p>
        </div>
      </figure>
      </div>
    </div>
  </section>

  <!-- SCROLL MARQUEE -->
  <div class="mq" aria-hidden="true">
    <div class="mq-track" data-marquee="-1">
      {marqueeWords.map(() => (
        <span class="mq-item">Signal <span class="soft">vs</span> Noise <i></i></span>
      ))}
    </div>
  </div>

  <!-- BEATS -->
  <section class="sec beats">
    <div class="wrap" data-reveal>
      <p class="sec-label"><span>01</span>Highlights</p>
      <h2 class="beats-title">Five lines from the book</h2>
      <ol class="beat-list">
        {beats.map(b => (
          <li class="beat">
            <div class="slip">
              <span class="beat-ch">{b.ch}</span>
              <p>{b.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHAT YOU LEARN -->
  <section id="why" class="sec">
    <div class="wrap split" data-reveal>
      <div class="split-head">
        <p class="sec-label"><span>02</span>Outcomes</p>
        <h2>What you will be able to do by the end</h2>
        <p class="lede">Not theory. Things you can use on your next project, this week.</p>
      </div>
      <ol class="learn">
        {learn.map((item, i) => (
          <li>
            <span class="n">{pad(i + 1)}</span>
            <p>{item.text}</p>
            <span class="ref">{item.ref}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LETTER -->
  <section class="sec letter">
    <div class="wrap split" data-reveal>
      <div class="split-head">
        <p class="sec-label"><span>03</span>The letter</p>
        <h2>Why I wrote it</h2>
      </div>
      <div class="letter-body">
        <p class="letter-lede">I spent fifteen years getting good at something, then watched everyone
          announce it was over.</p>
        <p>You know the posts. Designers are finished. Learn to prompt or get
          replaced. Usually attached to a course.</p>
        <p>I did not want to argue with it or ignore it. I wanted to know if it was true, so I did what
          we do with any unfamiliar system: I opened it up and looked at how it works.</p>
        <p>What I found was not what either camp is selling. Machines really did get fast at the
          surface: the layout, the first draft, the tidy summary. But they did not get good at the part
          underneath. They cannot tell which of fifteen findings matters. They cannot know your users
          are pharmacists working under time pressure with gloves on. They cannot sit in a room and say
          the feature should not be built at all.</p>
        <p>That part is what you have been quietly building for years. You have just never had to name
          it, because nothing was competing with you at the surface.</p>
        <p>This book helps you name it. Plain language, real mechanics, and my own failures included,
          because the failures are where the useful rules come from.</p>
        <p class="signature">Oussama</p>
      </div>
    </div>
  </section>

  <!-- CHAPTERS -->
  <section id="chapters" class="sec">
    <div class="wrap" data-reveal>
      <div class="chapters-head">
        <p class="sec-label"><span>04</span>Contents</p>
        <h2>The eleven chapters</h2>
        <p class="lede">Four parts. Read them in order the first time through.</p>
      </div>


      <!-- A page from the book, sitting on a small stack of sheets -->
      <div class="toc-stack">
        <article class="toc-page" aria-label="Table of contents">
          <header class="toc-running">
            <span>Signal vs Noise</span>
            <span>Oussama Bougnouch</span>
          </header>

          <h3 class="toc-title">Contents</h3>

          <ol class="toc">
            {toc.map(e => (
              <li class={`toc-row is-${e.kind}`}>
                {e.kind === "chapter" && <span class="toc-n">{pad(e.n)}</span>}
                <span class="toc-t">
                  {e.kind === "part" && <span class="toc-kicker">Part {e.n}</span>}
                  {e.t}
                </span>
                <span class="toc-leader" aria-hidden="true"></span>
                <span class="toc-pg"><span class="sr-only">page </span>{e.page}</span>
              </li>
            ))}
          </ol>

          <footer class="toc-folio" aria-hidden="true">6</footer>
        </article>
      </div>
    </div>
  </section>

  <!-- RED BAND WITH CAPTURE: the cover's burst, in miniature -->
  <section class="band band-red">
    <div class="wrap band-center" data-reveal>
      <p class="band-kicker">Free PDF &middot; 11 chapters &middot; About an hour</p>
      <h3>Read it in an hour. Keep the parts that change how you work.</h3>
      <Signup id="e3" source="strip" tone="red" class="band-signup" fine="No card, no spam. One click to leave." />
    </div>
  </section>

  <!-- REVIEW WALL -->
  <section class="sec">
    <div class="wrap" data-reveal>
      <div class="chapters-head">
        <p class="sec-label"><span>05</span>Readers</p>
        <h2>What readers say</h2>
        <p class="lede">Real quotes only, from people who have read it.</p>
      </div>
      <Reviews />
    </div>
  </section>

  <!-- PROOF -->
  <section class="sec proof">
    <div class="wrap" data-reveal>
      <div class="chapters-head">
        <p class="sec-label"><span>06</span>Proof</p>
        <h2>Why listen to me</h2>
        <p class="lede">Three things I can point at, rather than three things I can claim.</p>
      </div>
      <dl class="figs">
        <div>
          <dt>10,800</dt>
          <dd>Support tickets analysed with AI on one project, then validated in a workshop with more
            than twenty real users before a single screen was redesigned.</dd>
        </div>
        <div>
          <dt>113 <span class="soft">vs</span> 53</dt>
          <dd>My own agent reported 113 files created. There were 53. The full story is in the book,
            because it produced the rule I now apply to everything.</dd>
        </div>
        <div>
          <dt>15 <span class="small">years</span></dt>
          <dd>Product and UX design, including work with teams at CHANEL, AT&amp;T, HelloFresh
            and Fnac.</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- FIT -->
  <section class="sec">
    <div class="wrap" data-reveal>
      <div class="chapters-head">
        <p class="sec-label"><span>07</span>Fit</p>
        <h2>Who it is for</h2>
      </div>
      <div class="fit">
        <div class="fit-card yes">
          <h3>Read it if</h3>
          <ul>
            <li><i aria-hidden="true">&#10003;</i><span>You design products and the AI conversation has started to feel personal.</span></li>
            <li><i aria-hidden="true">&#10003;</i><span>You have used the tools and got answers that looked right and were not.</span></li>
            <li><i aria-hidden="true">&#10003;</i><span>You would rather understand the machine than memorise tricks for it.</span></li>
            <li><i aria-hidden="true">&#10003;</i><span>You want one honest hour instead of forty hours of hype.</span></li>
          </ul>
        </div>
        <div class="fit-card no">
          <h3>Skip it if</h3>
          <ul>
            <li><i aria-hidden="true">&#10005;</i><span>You want prompt templates to copy and paste. There are none in here.</span></li>
            <li><i aria-hidden="true">&#10005;</i><span>You are an ML engineer. You already know the first three chapters.</span></li>
            <li><i aria-hidden="true">&#10005;</i><span>You want to be told everything is fine. Some of it is not, and I say so.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- AUTHOR -->
  <section id="about" class="sec">
    <div class="wrap split" data-reveal>
      <div class="split-head">
        <p class="sec-label"><span>08</span>Author</p>
        <h2>Who wrote it</h2>
      </div>
      <div class="about">
        <div class="about-id">
          <img src="/assets/author.jpg" width="200" height="200" alt="Oussama Bougnouch" loading="lazy" />
          <p class="letter-lede">Oussama Bougnouch, product and UX designer, fifteen years.</p>
        </div>
        <p>I have built design systems, research
          operations and production interfaces for teams at CHANEL, AT&amp;T, HelloFresh and Fnac.
          These days I build AI systems for design work: local models, agents, and the instruction
          files that keep them honest.</p>
        <p>I publish what breaks alongside what works. I wrote this book
          because the advice designers were getting was either panic or cheerleading, and neither one
          tells you what to do on Monday morning.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec">
    <div class="wrap split" data-reveal>
      <div class="split-head">
        <p class="sec-label"><span>09</span>FAQ</p>
        <h2>Questions people ask first</h2>
      </div>
      <div class="faq">
        {faqs.map(f => (
          <details>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSE -->
  <section class="band band-close">
    <div class="wrap close-grid" data-reveal>
      <div class="close-cover" aria-hidden="true">
        <img src="/assets/signal-noise-cover-650.jpg" width="433" height="650" alt="" loading="lazy" />
      </div>
      <div class="close-copy">
        <h3>An hour from now you could <span class="soft">stop wondering where you stand.</span></h3>
        <Signup id="e2" source="footer" tone="dark" fine="Eleven chapters. Free. Leave any time with one click." />
      </div>
    </div>
  </section>

</PageLayout>

<style>
  .wrap {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 640px) {
    .wrap {
      padding: 0 2rem;
    }
  }

  h1,
  h2,
  h3 {
    font-weight: 700;
    color: var(--content);
    letter-spacing: -0.035em;
  }

  /* The cover lettering is reserved for the hero headline */
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.005em;
  }

  /* Secondary emphasis stays neutral: red is kept for buttons and links */
  .soft {
    color: var(--content-faint);
  }

  .band .soft,
  .mq .soft {
    color: rgb(255 255 255 / 0.5);
  }

  h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.05;
  }

  p {
    color: var(--content-muted);
  }

  /* One body size everywhere; headings are always larger than this */
  p,
  li,
  dd,
  blockquote {
    font-size: var(--text-size);
    line-height: var(--text-leading);
  }

  .lede {
    margin-top: 1.25rem;
    font-size: var(--text-size);
    line-height: 1.55;
    max-width: 30rem;
  }

  /* Sections are separated by space alone, no rules */
  .sec {
    padding: 6rem 0;
  }

  .sec-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--content);
  }

  .sec-label span {
    display: inline-grid;
    place-items: center;
    min-width: 2.2rem;
    height: 1.6rem;
    padding: 0 0.4rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    background: var(--content);
    border-radius: 2px;
  }

  /* Sticky heading column on the left, content on the right */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 4rem;
    align-items: start;
  }

  .split-head {
    position: sticky;
    top: 7rem;
  }

  .chapters-head {
    max-width: 50rem;
    margin-bottom: 3.5rem;
  }

  /* ---------- hero ---------- */
  .hero {
    padding: 2rem 0 0;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3rem;
    align-items: center;
    min-height: min(calc(100svh - 9.5rem), 52rem);
    padding-bottom: 3.5rem;
  }

  .hero-copy h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.6rem, 4.6vw, 4.3rem);
    line-height: 0.96;
    max-width: 15ch;
  }

  /* Keep the small label small (the body-size rule above would enlarge it) */
  .hero-copy .eyebrow {
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .hero-sub {
    margin-top: 1.75rem;
    max-width: 32rem;
    font-size: var(--text-size);
    line-height: 1.55;
  }

  .hero-signup {
    margin-top: 2.25rem;
  }

  .hero-book {
    position: relative;
    display: grid;
    place-items: center;
    padding: 3rem 0 4.5rem;
  }

  /* A quiet paper disc to seat the book */
  .book-disc {
    position: absolute;
    inset: 50% auto auto 50%;
    width: min(30rem, 100%);
    aspect-ratio: 1;
    translate: -50% -52%;
    border-radius: 50%;
    background: var(--ink-2);
    pointer-events: none;
  }






  /* ---------- quotes ---------- */
  .quotes {
    padding: 6rem 0;
  }

  .quotes-title,
  .beats-title {
    margin-bottom: 2.5rem;
  }

  .quotes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .quotes figcaption {
    padding-bottom: 0.7rem;
    border-bottom: 1px dashed var(--line-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--content-faint);
  }

  .quotes blockquote {
    position: relative;
    margin-top: 1.1rem;
    font-size: var(--text-size);
    font-weight: 600;
    line-height: var(--text-leading);
    letter-spacing: -0.01em;
    color: var(--content);
  }

  .quotes blockquote::before {
    content: "\201C";
    display: block;
    height: 0.62em;
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--content);
  }

  .quotes figure p {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  /* ---------- marquee ---------- */
  .mq {
    overflow: hidden;
    padding: 1.4rem 0 1.1rem;
    background: var(--content);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    user-select: none;
  }

  .mq-track {
    display: inline-flex;
    will-change: transform;
  }

  .mq-item {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    padding-right: 0.28em;
  }

  .mq-item i {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.2em;
    border-radius: 50%;
    background: var(--signal);
  }

  /* ---------- beats: torn paper slips ---------- */
  /* Flex rather than grid so the last row of slips sits centred */
  .beat-list {
    --cols: 3;
    --gap-x: 2rem;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 2.75rem var(--gap-x);
    padding-top: 0.5rem;
  }

  /* The shadow lives on the wrapper so it follows the torn edge of the slip */
  .beat,
  .paper {
    --tilt: -1.2deg;
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap-x)) / var(--cols));
    filter:
      drop-shadow(0 1px 1px rgb(20 18 14 / 0.1))
      drop-shadow(0 12px 14px rgb(20 18 14 / 0.1));
    transform: rotate(var(--tilt));
    transition: transform 0.6s var(--ease-out);
  }

  .beat:nth-child(2) { --tilt: 0.9deg; margin-top: 1.5rem; }
  .beat:nth-child(3) { --tilt: -0.5deg; }
  .beat:nth-child(4) { --tilt: 1.3deg; }
  .beat:nth-child(5) { --tilt: -0.8deg; margin-top: 1rem; }

  .paper:nth-child(1) { --tilt: -1deg; }
  .paper:nth-child(2) { --tilt: 1.1deg; margin-top: 1.5rem; }

  .beat:hover,
  .paper:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .slip {
