---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();

// JSON-LD FAQ schema for AEO
let faqJsonLd: string | null = null;
if (post.data.faq && post.data.faq.length > 0) {
  const schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": post.data.faq.map((item: { q: string; a: string }) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  };
  faqJsonLd = JSON.stringify(schema);
}
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(post.body)} read
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {post.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>

    {post.data.faq && post.data.faq.length > 0 && (
      <div class="mt-12 animate">
        <h2 class="text-xl font-semibold mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {post.data.faq.map((item: { q: string; a: string }, i: number) => (
            <details class="border border-gray-200 dark:border-gray-700 rounded-lg">
              <summary class="font-medium cursor-pointer px-4 py-3">{item.q}</summary>
              <div class="px-4 pb-3 text-gray-600 dark:text-gray-300">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    )}
  </Container>

  {faqJsonLd && (
    <script type="application/ld+json" id="faq-schema">
      {faqJsonLd}
    </script>
  )}
</PageLayout>