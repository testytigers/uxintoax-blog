---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Cover from "@components/Cover.astro";
import PostCard from "@components/PostCard.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { readingTime } from "@lib/utils";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map(post => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();

const all = (await getCollection("blog"))
  .filter(p => !p.data.draft && p.slug !== post.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tags: string[] = post.data.tags ?? [];
const related = [
  ...all.filter(p => (p.data.tags ?? []).some((t: string) => tags.includes(t))),
  ...all,
]
  .filter((p, i, arr) => arr.findIndex(x => x.slug === p.slug) === i)
  .slice(0, 3);

// JSON-LD FAQ schema for AEO
let faqJsonLd: string | null = null;
if (post.data.faq && post.data.faq.length > 0) {
  faqJsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: post.data.faq.map((item: { q: string; a: string }) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  });
}
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  articleDate={post.data.date.toISOString()}
  progress
>
  <!-- Article header -->
  <section class="border-b border-line">
    <Container size="narrow">
      <div class="py-10 sm:py-14">
        <div class="animate">
          <BackToPrev href="/blog">All articles</BackToPrev>
        </div>

        {tags.length > 0 && (
          <ul class="animate mt-8 flex flex-wrap gap-2">
            {tags.slice(0, 4).map((tag: string) => (
              <li class="pill">{tag}</li>
            ))}
          </ul>
        )}

        <h1 class="animate mt-5 text-title text-content">{post.data.title}</h1>

        <p class="animate mt-6 font-serif text-lg leading-relaxed text-content-muted sm:text-xl">
          {post.data.description}
        </p>

        <div class="animate mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-content-faint">
          <FormattedDate date={post.data.date} />
          <span class="size-1 rounded-full bg-line-strong"></span>
          <span>{readingTime(post.body)}</span>
        </div>
      </div>
    </Container>
  </section>

  <Container size="narrow">
    <div class="animate mt-10 overflow-hidden rounded-card border border-line">
      <Cover seed={post.slug} class="aspect-[16/7] w-full" />
    </div>

    <article class="prose animate mt-12">
      <Content />
    </article>

    {post.data.faq && post.data.faq.length > 0 && (
      <section class="animate mt-20">
        <h2 class="text-heading text-content">Frequently asked questions</h2>
        <div class="mt-7 divide-y divide-line overflow-hidden rounded-card border border-line bg-surface">
          {post.data.faq.map((item: { q: string; a: string }) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-base font-semibold text-content transition-colors hover:text-brand">
                {item.q}
                <svg viewBox="0 0 24 24" class="size-5 shrink-0 fill-none stroke-brand stroke-2 transition-transform duration-300 group-open:rotate-45">
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </summary>
              <p class="px-6 pb-6 font-serif leading-relaxed text-content-muted">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </Container>

  {related.length > 0 && (
    <section class="mt-24 border-t border-line pt-14 sm:pt-20">
      <Container>
        <h2 class="animate text-heading text-content">Keep reading</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map(entry => (
            <div class="animate">
              <PostCard entry={entry} />
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}

  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}
</PageLayout>
