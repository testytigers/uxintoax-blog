---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PostList from "@components/PostList.astro";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = { [year: string]: CollectionEntry<"blog">[] };

const posts = data.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString();
  (acc[year] ||= []).push(post);
  return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container size="narrow">
    <header class="pb-10 pt-16 sm:pb-14 sm:pt-24" data-reveal>
      <h1 class="text-title text-content">Articles</h1>
      <p class="mt-4 text-lg leading-relaxed text-content-muted">
        Plain writing on what AI is really doing, where it breaks, and how to use it well in UX work.
      </p>
    </header>

    <div class="space-y-12 pb-24 sm:pb-32">
      {years.map(year => (
        <section data-reveal>
          <h2 class="mb-3 text-sm font-semibold text-content-faint">{year}</h2>
          <PostList entries={posts[year]} />
        </section>
      ))}
    </div>
  </Container>
</PageLayout>
