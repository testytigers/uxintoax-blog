---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import PostCard from "@components/PostCard.astro";
import Marquee from "@components/Marquee.astro";
import { SITE, HOME } from "@consts";

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const [lead, ...rest] = posts;
const featured = rest.slice(0, 2);

// Only fill complete rows of three so the grid never ends on an orphan card.
const pool = rest.slice(2);
const latest =
  pool.length >= 3 ? pool.slice(0, Math.min(6, Math.floor(pool.length / 3) * 3)) : pool;

const topics = [...new Set(posts.flatMap(p => p.data.tags ?? []))].slice(0, 10);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <!-- Hero, built like the black label on a coffee tin -->
  <section class="py-10 sm:py-16">
    <Container>
      <div class="plate plate-inset deco-corners animate overflow-hidden px-6 py-14 sm:px-14 sm:py-20">
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow">Est. 2025 &middot; Maison of UX</p>

          <div class="deco-rule mx-auto mt-5 max-w-[14rem]">
            <span class="diamond"></span>
          </div>

          <h1 class="mt-6 font-serif text-display text-content">
            The craft of <span class="text-brand">user experience</span>, served strong.
          </h1>

          <p class="mx-auto mt-7 max-w-2xl font-serif text-lg leading-relaxed text-content-muted">
            Practical UX design strategies and AI integration guides for modern designers.
            Frameworks, process, and tooling, written to be used rather than admired.
          </p>

          <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
            <a href="/blog" class="btn btn-primary">
              Read the articles
              <svg viewBox="0 0 24 24" class="size-3.5 fill-none stroke-current stroke-[2.5]">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
            <a href={`mailto:${SITE.EMAIL}`} class="btn btn-ghost">Get in touch</a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Marquee text="Featured Articles" />

  <!-- Lead + featured -->
  <section class="py-14 sm:py-20">
    <Container>
      <div class="grid gap-6 lg:grid-cols-[1.35fr_1fr]">
        {lead && (
          <div class="animate">
            <PostCard entry={lead} variant="featured" />
          </div>
        )}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
          {featured.map(post => (
            <div class="animate">
              <PostCard entry={post} variant="row" />
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <Marquee text="Latest Posts" />

  <!-- Latest grid -->
  <section class="py-14 sm:py-20">
    <Container>
      <div class="animate mb-10">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="font-serif text-heading text-content">Latest posts</h2>
          <a
            href="/blog"
            class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-brand underline-offset-4 hover:underline"
          >
            See all articles &rarr;
          </a>
        </div>
        <div class="mt-4 h-px w-full bg-brand/30"></div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map(post => (
          <div class="animate">
            <PostCard entry={post} />
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Topics + contact -->
  <section class="pb-16 sm:pb-24">
    <Container>
      <div class="plate plate-inset deco-corners animate p-8 sm:p-12">
        <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
          <div>
            <h2 class="font-serif text-heading text-content">No fluff, no theory.</h2>
            <p class="mt-4 max-w-xl font-serif text-lg leading-relaxed text-content-muted">
              Every article is grounded in real project work. If you want to talk about something,
              or just say hi, reach out.
            </p>
            <a href={`mailto:${SITE.EMAIL}`} class="btn btn-primary mt-7">
              {SITE.EMAIL}
            </a>
          </div>
          <div>
            <h3 class="eyebrow">Topics covered</h3>
            <div class="mt-3 h-px w-full bg-brand/25"></div>
            <ul class="mt-4 flex flex-wrap gap-2">
              {topics.map(topic => (
                <li class="badge">{topic}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
