---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { SITE, HOME } from "@consts";
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section>
        <h4 class="animate font-semibold text-black dark:text-white">
          UX Architect <span class="text-xl">👋🏻</span>
        </h4>
        <article class="animate space-y-4">
          <p class="text-lg">
            Practical strategies, processes &amp; tools for UX designers navigating the AI revolution.
            We cover how to design for AI-powered features, use AI in your design process, and build
            products that feel both intelligent and human.
          </p>
          <p class="opacity-75">
            Every article is grounded in real experience. No fluff, no theory. Just actionable
            strategies for the intersection of UX and AI.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest articles
          </h5>
          <a href="/blog" class="underline">
            See all posts
          </a>
        </div>
        <ul class="flex flex-col gap-4">
          {
            (await getCollection("blog"))
              .filter(post => !post.data.draft)
              .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
              .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)
              .map(post => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch about something or just to say hi, reach out on social media.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          <li class="flex gap-x-2 text-nowrap">
            <a href="mailto:{SITE.EMAIL}" class="underline">
              {SITE.EMAIL}
            </a>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
