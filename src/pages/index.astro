---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Signup from "@components/Signup.astro";
import { HOME, BOOK_PATH } from "@consts";

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// A reading path for newcomers, in order. Slugs, so titles stay in sync.
const START_HERE = [
  "the-apple-test",
  "ai-just-predicts-the-next-word",
  "why-ai-makes-things-up",
  "what-ai-can-actually-see",
  "garbage-in-garbage-out",
];

const startHere = START_HERE.map(slug => posts.find(p => p.slug === slug)).filter(p => p !== undefined);
const latest = posts.filter(p => !START_HERE.includes(p.slug)).slice(0, 5);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <!-- NEWSLETTER HERO -->
  <section id="subscribe" class="hero">
    <div class="wrap hero-inner" data-reveal>
      <h1>
        <span class="soft">The UXINTOAX</span>
        Newsletter
      </h1>
      <p class="hero-sub">
        One practical idea a week for UX and product designers: what AI is really doing, where it
        breaks, and the habits that make it useful in real work.
      </p>
      <Signup id="hero-email" source="home-hero" list="blog" class="hero-form" fine="No hype. No prompt tricks. One click to leave." />
    </div>
  </section>

  <!-- INTRO + READING PATHS -->
  <section class="panel-sec">
    <div class="wrap">
      <div class="panel card-soft" data-reveal>
        <div class="panel-intro">
          <p class="intro-lede">
            Hi, I am Oussama Bougnouch. Product and UX designer for fifteen years, with teams at
            CHANEL, AT&amp;T, HelloFresh and Fnac.
          </p>
          <p>
            These days I build AI systems for design work: local models, agents, and the instruction
            files that keep them honest.
          </p>
          <p>
            This site is what I learn doing it, including what breaks. Read a few posts, then try one
            thing on your next project.
          </p>

          <a href={BOOK_PATH} class="book-card">
            <img src="/assets/signal-noise-cover-650.jpg" width="433" height="650" alt="" loading="lazy" />
            <span>
              <b>Signal vs Noise, the free AI book for UX designers.</b>
              <span class="book-link">Get the free book</span>
            </span>
          </a>
        </div>

        <div class="panel-lists">
          <h2>Start here (in order):</h2>
          <ol class="links numbered">
            {startHere.map(p => (
              <li><a href={`/blog/${p.slug}`}>{p.data.title}</a></li>
            ))}
          </ol>

          <h2>Latest:</h2>
          <ul class="links">
            {latest.map(p => (
              <li><a href={`/blog/${p.slug}`}>{p.data.title}</a></li>
            ))}
          </ul>

          <a href="/blog" class="all-link">All {posts.length} articles &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER, AGAIN -->
  <section class="closing">
    <div class="wrap closing-grid" data-reveal>
      <div>
        <h2 class="closing-title">
          <span class="soft">The UXINTOAX</span>
          Newsletter
        </h2>
        <p>
          One idea from real design work, one habit you can try this week. Sent when there is
          something worth sending.
        </p>
      </div>
      <Signup id="closing-email" source="home-closing" list="blog" fine="No spam. Leave any time with one click." />
    </div>
  </section>
</PageLayout>

<style>
  .wrap {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 640px) {
    .wrap {
      padding: 0 2rem;
    }
  }

  p {
    font-size: var(--text-size);
    line-height: var(--text-leading);
    color: var(--content-muted);
  }

  .soft {
    display: block;
    color: var(--content-faint);
  }

  /* ---------- hero ---------- */
  .hero {
    padding: 6.5rem 0 5rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--content);
  }

  .hero-sub {
    max-width: 34rem;
    margin-top: 1.5rem;
  }

  .hero :global(.hero-form) {
    margin-top: 2rem;
  }

  .hero :global(.hero-form .fine) {
    text-align: center;
  }

  /* ---------- panel ---------- */
  .panel-sec {
    padding-bottom: 5rem;
  }

  .panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
  }

  .panel-intro {
    padding: 3rem;
    background: var(--ink-2);
    border-right: var(--card-border);
  }

  .panel-intro p + p {
    margin-top: 1rem;
  }

  .intro-lede {
    font-size: 1.3rem !important;
    line-height: 1.5 !important;
    color: var(--content) !important;
    margin-bottom: 1.5rem;
  }

  .book-card {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 2rem;
    padding: 1rem;
    border: var(--card-border);
    border-radius: var(--card-radius);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  .book-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
  }

  .book-card img {
    width: 4rem;
    height: auto;
    flex-shrink: 0;
    border-radius: 2px 4px 4px 2px;
    box-shadow: 0 6px 14px -6px rgb(13 12 10 / 0.5);
  }

  .book-card b {
    display: block;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--content);
  }

  .book-link {
    display: inline-block;
    margin-top: 0.4rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .panel-lists {
    padding: 3rem;
  }

  .panel-lists h2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--content);
  }

  .panel-lists h2 + .links {
    margin-top: 1rem;
  }

  .links + h2 {
    margin-top: 2.25rem;
  }

  .links {
    display: grid;
    gap: 0.85rem;
    list-style: none;
  }

  .links.numbered {
    list-style: decimal;
    padding-left: 1.25rem;
  }

  .links li {
    font-size: 1rem;
    line-height: 1.45;
    color: var(--content);
  }

  .links li::marker {
    color: var(--content-faint);
  }

  /* Plain text with a red underline: red is for links only */
  .links a {
    color: var(--content);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--accent);
  }

  .all-link {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 600;
    color: var(--accent);
  }

  .all-link:hover {
    color: var(--accent-deep);
  }

  /* ---------- closing ---------- */
  .closing {
    padding: 4.5rem 0 6rem;
    border-top: 1px solid var(--line);
  }

  .closing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .closing-title {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--content);
  }

  .closing-grid p {
    max-width: 28rem;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 860px) {
    .panel,
    .closing-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .panel-intro {
      border-right: 0;
      border-bottom: var(--card-border);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4rem 0 3.5rem;
    }

    .panel-intro,
    .panel-lists {
      padding: 1.75rem 1.4rem;
    }

    .intro-lede {
      font-size: 1.15rem !important;
    }
  }
</style>
