---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  articleDate?: string;
  progress?: boolean;
  noindex?: boolean;
  /** "book" keeps the cover red on the book pages; everything else uses the green brand. */
  theme?: "site" | "book";
};

const { title, description, image, type, articleDate, progress = false, noindex = false, theme = "site" } = Astro.props;
---

<!doctype html>
<html lang="en" class={theme === "book" ? "theme-book" : undefined}>
  <head>
    <Head
      title={`${title} | ${SITE.NAME}`}
      description={description}
      image={image}
      type={type}
      articleDate={articleDate}
      noindex={noindex}
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PKJ74RN9"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-brand focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    {progress && <div id="read-progress"></div>}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
