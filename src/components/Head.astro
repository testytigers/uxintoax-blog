---
import "../styles/global.css";
import "@fontsource/figtree/latin-400.css";
import "@fontsource/figtree/latin-500.css";
import "@fontsource/figtree/latin-600.css";
import "@fontsource/figtree/latin-700.css";
import "@fontsource/figtree/latin-800.css";
import "@fontsource/anton/latin-400.css";
import figtree400 from "@fontsource/figtree/files/figtree-latin-400-normal.woff2";
import figtree600 from "@fontsource/figtree/files/figtree-latin-600-normal.woff2";
import figtree700 from "@fontsource/figtree/files/figtree-latin-700-normal.woff2";
import anton400 from "@fontsource/anton/files/anton-latin-400-normal.woff2";

import { SITE } from "@consts";

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
  type?: "website" | "article";
  articleDate?: string;
  canonical?: string;
  noindex?: boolean;
}

const props = Astro.props;
const canonicalURL = props.canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImage = props.image || "/og-home.jpg";
const twitterImage = props.image || "/og-twitter.jpg";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)">
<link rel="icon" type="image/x-icon" href="/favicon-light.svg">
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0D0C0A">
<meta name="view-transition" content="same-origin" />

<!-- Font preloads -->
<link rel="preload" href={figtree400} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={figtree600} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={figtree700} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={anton400} as="font" type="font/woff2" crossorigin/>

{props.noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{props.title}</title>
<meta name="title" content={props.title} />
<meta name="description" content={props.description} />
{props.keywords && <meta name="keywords" content={props.keywords} />}
<meta name="author" content={SITE.NAME} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={props.type || "website"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={props.title} />
<meta property="og:description" content={props.description} />
<meta property="og:image" content={new URL(ogImage, Astro.url).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE.NAME} />
{props.articleDate && <meta property="article:published_time" content={props.articleDate} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={props.title} />
<meta property="twitter:description" content={props.description} />
<meta property="twitter:image" content={new URL(twitterImage, Astro.url).href} />

<!-- RSS Link -->
<link rel="alternate" type="application/rss+xml" title={SITE.NAME} href={new URL("rss.xml", Astro.site).href} />

<!-- Structured Data: Organization -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "UXintoax",
  "url": "https://uxintoax.com",
  "description": "Practical UX design strategies and AI integration guides for modern designers",
  "email": "hello@uxintoax.com",
  "sameAs": [
    "https://twitter.com/uxintoax",
    "https://github.com/uxintoax",
    "https://www.linkedin.com/company/uxintoax",
    "https://dribbble.com/uxintoax"
  ]
}
</script>

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-HH8M2D27CW"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-HH8M2D27CW');
</script>

<!-- Motion switch: content is only hidden-for-animation when this class is present.
     If the motion module fails to boot, the class is removed so nothing stays invisible. -->
<script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var root = document.documentElement;
    root.classList.add("motion");
    setTimeout(function () {
      if (!window.__motion) root.classList.remove("motion");
    }, 2500);
  })();
</script>

<script>
  import "../scripts/motion.ts";
</script>
