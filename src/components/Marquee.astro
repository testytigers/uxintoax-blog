---
type Props = {
  text: string;
  repeat?: number;
};

const { text, repeat = 12 } = Astro.props;
const items = Array.from({ length: repeat });
---

<div class="marquee" role="presentation" aria-hidden="true">
  {[0, 1].map(() => (
    <div class="marquee__track">
      {items.map(() => (
        <span class="flex items-center gap-5">
          <span class="whitespace-nowrap text-[0.6875rem] font-semibold uppercase tracking-[0.24em] text-brand">
            {text}
          </span>
          <span class="diamond shrink-0"></span>
        </span>
      ))}
    </div>
  ))}
</div>
