---
type Props = {
  text: string;
  repeat?: number;
};

const { text, repeat = 10 } = Astro.props;
const items = Array.from({ length: repeat });
---

<div class="marquee" role="presentation" aria-hidden="true">
  <div class="marquee__track">
    {items.map(() => (
      <span class="flex items-center gap-6">
        <span class="whitespace-nowrap font-serif text-sm italic tracking-wide text-content-faint">{text}</span>
        <svg viewBox="0 0 24 24" class="size-3 shrink-0 fill-none stroke-brand stroke-[2.5]">
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </span>
    ))}
  </div>
  <div class="marquee__track" aria-hidden="true">
    {items.map(() => (
      <span class="flex items-center gap-6">
        <span class="whitespace-nowrap font-serif text-sm italic tracking-wide text-content-faint">{text}</span>
        <svg viewBox="0 0 24 24" class="size-3 shrink-0 fill-none stroke-brand stroke-[2.5]">
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </span>
    ))}
  </div>
</div>
