---
/**
 * Reader reviews: an honest empty state plus a "Write a review" dialog.
 * Submissions go to /api/review and are never published automatically.
 */
---

<div class="reviews-empty card-soft">
  <div class="empty-art" aria-hidden="true">
    <span class="sheet s1"></span>
    <span class="sheet s2"></span>
    <span class="sheet s3">
      <svg viewBox="0 0 24 24"><path d="M7 7h4v4H8.5c0 1.6.9 2.6 2.5 3v2c-3-.4-4-2.6-4-5.5V7Zm7 0h4v4h-2.5c0 1.6.9 2.6 2.5 3v2c-3-.4-4-2.6-4-5.5V7Z" /></svg>
    </span>
  </div>

  <h3>No reviews yet</h3>
  <p>
    Inventing praise would be exactly the failure chapter&nbsp;2 is about, so this space stays
    empty until real readers fill it. Read the book, then be the first to say what you think.
  </p>

  <button type="button" class="review-open" data-review-open>
    Write a review
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
  </button>
</div>

<dialog class="review-dialog" data-review-dialog aria-labelledby="review-title">
  <div class="dialog-card">
    <button type="button" class="dialog-close" data-review-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>

    <div data-review-body>
      <p class="dialog-kicker">Signal vs Noise</p>
      <h3 id="review-title">Write a review</h3>
      <p class="dialog-sub">Every review is read before it goes on the page. Nothing is edited except typos.</p>

      <form data-review-form novalidate>
        <div class="row-2">
          <label>
            <span>Your name</span>
            <input name="name" type="text" required maxlength="80" autocomplete="name" />
          </label>
          <label>
            <span>Role <em>(optional)</em></span>
            <input name="role" type="text" maxlength="80" placeholder="Product designer, Acme" />
          </label>
        </div>

        <label>
          <span>Your review</span>
          <textarea name="review" required minlength="20" maxlength="1200" rows="5"
            placeholder="What changed in how you work after reading it?"></textarea>
        </label>

        <label>
          <span>Email <em>(optional, never shown)</em></span>
          <input name="email" type="email" maxlength="160" autocomplete="email" placeholder="So I can thank you" />
        </label>

        <label class="consent">
          <input name="consent" type="checkbox" required />
          <span>You can publish this with my name and role.</span>
        </label>

        <p class="form-error" role="alert" hidden></p>

        <div class="dialog-actions">
          <button type="button" class="btn-cancel" data-review-close>Cancel</button>
          <button type="submit" class="btn-send">Send review</button>
        </div>
      </form>
    </div>

    <div class="dialog-done" data-review-done hidden>
      <span class="done-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12.5 10 17l9-10" /></svg>
      </span>
      <h3>Thank you</h3>
      <p>Your review is in. It will appear here once it has been read.</p>
      <button type="button" class="btn-send" data-review-close>Close</button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-review-dialog]");
  const form = dialog?.querySelector<HTMLFormElement>("[data-review-form]");
  const body = dialog?.querySelector<HTMLElement>("[data-review-body]");
  const done = dialog?.querySelector<HTMLElement>("[data-review-done]");
  const error = dialog?.querySelector<HTMLElement>(".form-error");
  const send = form?.querySelector<HTMLButtonElement>(".btn-send");

  if (dialog && form && body && done && error && send) {
    const lenis = () => (window as unknown as { __lenis?: { stop(): void; start(): void } }).__lenis;

    const open = () => {
      dialog.showModal();
      lenis()?.stop();
      form.querySelector<HTMLInputElement>("input[name=name]")?.focus();
    };

    const close = () => dialog.close();

    dialog.addEventListener("close", () => {
      lenis()?.start();
      // Reset after a successful send so the next visitor starts fresh
      if (!done.hidden) {
        form.reset();
        done.hidden = true;
        body.hidden = false;
      }
    });

    document.querySelectorAll("[data-review-open]").forEach((el) => el.addEventListener("click", open));
    dialog.querySelectorAll("[data-review-close]").forEach((el) => el.addEventListener("click", close));

    // Click on the backdrop closes
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.hidden = true;

      if (!form.checkValidity()) {
        const first = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(":invalid");
        error.textContent =
          first?.name === "review"
            ? "Please write at least a couple of sentences."
            : first?.name === "consent"
              ? "Please tick the box so the review can be published."
              : "Please fill in your name.";
        error.hidden = false;
        first?.focus();
        return;
      }

      const data = Object.fromEntries(new FormData(form));
      send.disabled = true;
      send.textContent = "Sending…";

      try {
        const res = await fetch("/api/review", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...data, consent: data.consent === "on" }),
        });
        const json = await res.json().catch(() => ({}) as { ok?: boolean; error?: string });
        if (res.ok && json.ok) {
          body.hidden = true;
          done.hidden = false;
        } else {
          error.textContent = json.error || "Something went wrong. Please try again.";
          error.hidden = false;
        }
      } catch {
        error.textContent = "Something went wrong. Please try again.";
        error.hidden = false;
      } finally {
        send.disabled = false;
        send.textContent = "Send review";
      }
    });
  }
</script>

<style>
  /* ---------- empty state ---------- */
  .reviews-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3.5rem 1.5rem 3.25rem;
  }

  .empty-art {
    position: relative;
    width: 7rem;
    height: 5.5rem;
    margin-bottom: 1.75rem;
  }

  .sheet {
    position: absolute;
    inset: 0 1rem;
    border: var(--card-border);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }

  .s1 {
    transform: rotate(-9deg) translateX(-0.9rem);
    background: var(--ink-2);
  }

  .s2 {
    transform: rotate(7deg) translateX(0.9rem);
    background: var(--wash);
  }

  .s3 {
    display: grid;
    place-items: center;
  }

  .s3 svg {
    width: 2rem;
    height: 2rem;
    fill: var(--content-faint);
  }

  .reviews-empty h3 {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--content);
  }

  .reviews-empty p {
    max-width: 30rem;
    margin-top: 0.75rem;
    font-size: var(--text-size);
    line-height: var(--text-leading);
    color: var(--content-muted);
  }

  .review-open,
  .btn-send {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.9rem 1.3rem;
    border: 0;
    border-radius: 3px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .review-open {
    margin-top: 1.75rem;
  }

  .review-open:hover,
  .btn-send:hover {
    background: var(--accent-deep);
  }

  .btn-send:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .review-open svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  /* ---------- dialog ---------- */
  .review-dialog {
    width: min(36rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .review-dialog::backdrop {
    background: rgb(13 12 10 / 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .review-dialog[open] {
    animation: dialog-in 0.45s var(--ease-out);
  }

  .review-dialog[open]::backdrop {
    animation: fade-in 0.3s ease;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .dialog-card {
    position: relative;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    padding: 2.25rem;
    border: var(--card-border);
    border-radius: var(--card-radius);
    background: var(--surface);
    box-shadow: 0 30px 80px -20px rgb(13 12 10 / 0.45);
    color: var(--content);
  }

  .dialog-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--content);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .dialog-close:hover {
    background: var(--ink-2);
  }

  .dialog-close svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .dialog-kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--content-faint);
  }

  .dialog-card h3 {
    margin-top: 0.5rem;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--content);
  }

  .dialog-sub {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--content-muted);
  }

  form {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
  }

  label > span {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--content);
  }

  label em {
    font-style: normal;
    font-weight: 400;
    color: var(--content-faint);
  }

  input[type="text"],
  input[type="email"],
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--surface);
    color: var(--content);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  textarea {
    resize: vertical;
    min-height: 7.5rem;
    line-height: 1.55;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--content-faint);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--content);
    box-shadow: 0 0 0 3px rgb(13 12 10 / 0.08);
  }

  .consent {
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.65rem;
  }

  .consent input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--content);
  }

  .consent span {
    font-weight: 400;
    color: var(--content-muted);
  }

  .form-error {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-deep);
  }

  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .btn-cancel {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: var(--surface);
    color: var(--content);
    cursor: pointer;
  }

  .btn-cancel:hover {
    border-color: var(--content);
  }

  /* ---------- success ---------- */
  .dialog-done {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 0 0.5rem;
  }

  .dialog-done[hidden] {
    display: none;
  }

  .done-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--signal);
  }

  .done-icon svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
  }

  .dialog-done p {
    margin: 0.5rem 0 1.5rem;
    color: var(--content-muted);
  }

  @media (max-width: 560px) {
    .dialog-card {
      padding: 1.75rem 1.25rem 1.5rem;
    }

    .row-2 {
      grid-template-columns: 1fr;
    }

    .dialog-actions {
      flex-direction: column-reverse;
    }

    .dialog-actions button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
