---
/**
 * Deterministic generated cover art.
 * Every post gets a stable palette + pattern derived from its slug,
 * so the grid looks designed rather than random, with zero image assets.
 */
type Props = {
  seed: string;
  class?: string;
};

const { seed, class: className = "" } = Astro.props;

// Two independent hashes so palette and pattern don't correlate.
const fnv = (s: string) => {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619) >>> 0;
  }
  return h;
};

const djb2 = (s: string) => {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;
  return h;
};

const palettes = [
  { bg: "#55b48e", ink: "#06251F", alt: "#0C3A31" },
  { bg: "#7ACFAC", ink: "#06251F", alt: "#0C3A31" },
  { bg: "#E4D8B8", ink: "#06251F", alt: "#3C8E6E" },
  { bg: "#C2D2EE", ink: "#06251F", alt: "#3C8E6E" },
  { bg: "#3C8E6E", ink: "#06251F", alt: "#E4D8B8" },
  { bg: "#EBC96A", ink: "#06251F", alt: "#0C3A31" },
];

const p = palettes[fnv(seed) % palettes.length];
const pattern = djb2(`${seed}|art`) % 6;
const flip = djb2(`${seed}|flip`) % 2 === 0;
---

<div class={`relative overflow-hidden bg-ink-2 ${className}`} aria-hidden="true">
  <svg
    viewBox="0 0 400 250"
    preserveAspectRatio="xMidYMid slice"
    class="h-full w-full"
    style={flip ? "transform: scaleX(-1)" : undefined}
  >
    <rect width="400" height="250" fill={p.bg} />

    {pattern === 0 && (
      <g fill="none" stroke={p.ink} stroke-width="2" opacity="0.9">
        {[26, 52, 78, 104, 130, 156, 182].map((r, i) => (
          <circle cx="300" cy="196" r={r} opacity={1 - i * 0.1} />
        ))}
        <circle cx="300" cy="196" r="12" fill={p.alt} stroke="none" />
      </g>
    )}

    {pattern === 1 && (
      <g>
        {Array.from({ length: 9 }).map((_, row) =>
          Array.from({ length: 15 }).map((_, col) => (
            <circle cx={16 + col * 27} cy={18 + row * 27} r="3.2" fill={p.ink} opacity="0.55" />
          ))
        )}
        <circle cx="286" cy="90" r="62" fill={p.alt} />
        <circle cx="286" cy="90" r="62" fill="none" stroke={p.ink} stroke-width="2" />
      </g>
    )}

    {pattern === 2 && (
      <g>
        {Array.from({ length: 10 }).map((_, i) => (
          <rect
            x={-60 + i * 52}
            y="-40"
            width={i % 3 === 0 ? 22 : 10}
            height="340"
            fill={i % 3 === 0 ? p.alt : p.ink}
            opacity={i % 3 === 0 ? 0.95 : 0.4}
            transform="rotate(18 200 125)"
          />
        ))}
      </g>
    )}

    {pattern === 3 && (
      <g fill="none" stroke={p.ink} stroke-width="2.5">
        <rect x="118" y="43" width="164" height="164" rx="26" fill={p.alt} stroke="none" />
        <rect x="118" y="43" width="164" height="164" rx="26" />
        <rect x="146" y="71" width="108" height="108" rx="18" />
        <rect x="174" y="99" width="52" height="52" rx="10" />
        <line x1="0" y1="125" x2="118" y2="125" />
        <line x1="282" y1="125" x2="400" y2="125" />
      </g>
    )}

    {pattern === 4 && (
      <g fill="none" stroke={p.ink} stroke-width="3" stroke-linecap="round">
        {Array.from({ length: 7 }).map((_, i) => (
          <path
            d={`M -20 ${40 + i * 30} q 50 -34 100 0 t 100 0 t 100 0 t 100 0`}
            opacity={0.35 + i * 0.09}
          />
        ))}
        <circle cx="316" cy="70" r="30" fill={p.alt} stroke="none" />
      </g>
    )}

    {pattern === 5 && (
      <g stroke={p.ink} stroke-width="2" fill="none">
        <path d="M60 190 L140 96 L240 150 L330 62" />
        <path d="M60 190 L150 200 L240 150 L340 176" opacity="0.45" />
        <circle cx="60" cy="190" r="13" fill={p.alt} />
        <circle cx="140" cy="96" r="19" fill={p.alt} />
        <circle cx="240" cy="150" r="15" fill={p.alt} />
        <circle cx="330" cy="62" r="24" fill={p.alt} />
        <circle cx="150" cy="200" r="9" fill={p.alt} opacity="0.6" />
        <circle cx="340" cy="176" r="11" fill={p.alt} opacity="0.6" />
      </g>
    )}
  </svg>
</div>
