---
/**
 * Deterministic generated cover art, drawn as a coffee-tin label:
 * a colour field, a geometric deco motif, and a gold hairline frame.
 * Palette and pattern come from the post slug, so each post keeps the
 * same label forever and the grid stays varied. No image assets needed.
 */
type Props = {
  seed: string;
  class?: string;
};

const { seed, class: className = "" } = Astro.props;

const fnv = (s: string) => {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619) >>> 0;
  }
  return h;
};

// Avalanche step. Without it, similar slugs land on neighbouring buckets and
// the archive shows the same label three times in a row.
const mix = (h: number) => {
  h ^= h >>> 16;
  h = Math.imul(h, 0x85ebca6b) >>> 0;
  h ^= h >>> 13;
  h = Math.imul(h, 0xc2b2ae35) >>> 0;
  h ^= h >>> 16;
  return h >>> 0;
};

const pick = (s: string) => mix(fnv(s));

const GOLD = "#E8B33C";
const CREAM = "#F8F3E7";
const NOIR = "#080D16";
const COBALT = "#0A5AAE";
const COBALT_BRIGHT = "#1276D8";
const NAVY = "#06356E";

const palettes = [
  { bg: COBALT, ink: GOLD, alt: CREAM, frame: GOLD },
  { bg: GOLD, ink: NOIR, alt: COBALT, frame: NOIR },
  { bg: NOIR, ink: GOLD, alt: COBALT_BRIGHT, frame: GOLD },
  { bg: CREAM, ink: NAVY, alt: GOLD, frame: NAVY },
  { bg: NAVY, ink: GOLD, alt: COBALT_BRIGHT, frame: GOLD },
  { bg: COBALT_BRIGHT, ink: CREAM, alt: GOLD, frame: CREAM },
];

const p = palettes[pick(`${seed}|colour`) % palettes.length];
const pattern = pick(`${seed}|art`) % 8;
const flip = pick(`${seed}|flip`) % 2 === 0;

// Continuous variation on top of palette + motif. Scale never drops below 1
// so a full-bleed motif can't pull away from the edges of the label.
const rot = [-9, -6, -3, 0, 3, 6, 9][pick(`${seed}|rot`) % 7];
const scale = [1, 1.08, 1.18, 1.3][pick(`${seed}|scale`) % 4];
const ox = [-30, -14, 0, 14, 30][pick(`${seed}|ox`) % 5];
const oy = [-18, -6, 0, 6, 18][pick(`${seed}|oy`) % 5];
const motif = `translate(${200 + ox} ${125 + oy}) rotate(${rot}) scale(${scale}) translate(-200 -125)`;
---

<div class={`relative overflow-hidden bg-surface ${className}`} aria-hidden="true">
  <svg
    viewBox="0 0 400 250"
    preserveAspectRatio="xMidYMid slice"
    class="h-full w-full"
    style={flip ? "transform: scaleX(-1)" : undefined}
  >
    <rect width="400" height="250" fill={p.bg} />

    <g opacity="0.95" transform={motif}>
      {/* 0 — deco sunburst, the rays on the tin lids */}
      {pattern === 0 && (
        <g>
          {Array.from({ length: 24 }).map((_, i) => (
            <path
              d={`M 200 125 L ${200 + 300 * Math.cos((i * 15 - 90) * Math.PI / 180)} ${
                125 + 300 * Math.sin((i * 15 - 90) * Math.PI / 180)
              } L ${200 + 300 * Math.cos((i * 15 - 83) * Math.PI / 180)} ${
                125 + 300 * Math.sin((i * 15 - 83) * Math.PI / 180)
              } Z`}
              fill={p.ink}
              opacity={i % 2 ? 0.5 : 0.85}
            />
          ))}
          <circle cx="200" cy="125" r="42" fill={p.bg} stroke={p.alt} stroke-width="2" />
          <circle cx="200" cy="125" r="30" fill="none" stroke={p.ink} stroke-width="1.5" />
        </g>
      )}

      {/* 1 — stepped deco arch */}
      {pattern === 1 && (
        <g fill="none" stroke={p.ink} stroke-width="2.5">
          {[0, 1, 2, 3, 4].map(i => (
            <path
              d={`M ${112 + i * 15} 250 L ${112 + i * 15} ${132 - i * 16} Q 200 ${
                70 - i * 22
              } ${288 - i * 15} ${132 - i * 16} L ${288 - i * 15} 250`}
              opacity={0.35 + i * 0.15}
            />
          ))}
          <circle cx="200" cy="96" r="17" fill={p.alt} stroke="none" />
        </g>
      )}

      {/* 2 — diamond lattice */}
      {pattern === 2 && (
        <g>
          {Array.from({ length: 6 }).map((_, row) =>
            Array.from({ length: 9 }).map((_, col) => {
              const x = 8 + col * 48 + (row % 2 ? 24 : 0);
              const y = 12 + row * 45;
              const big = (row + col) % 3 === 0;
              return (
                <rect
                  x={x - 13}
                  y={y - 13}
                  width="26"
                  height="26"
                  transform={`rotate(45 ${x} ${y})`}
                  fill={big ? p.alt : "none"}
                  stroke={p.ink}
                  stroke-width="2"
                  opacity={big ? 0.95 : 0.6}
                />
              );
            })
          )}
        </g>
      )}

      {/* 3 — fluted columns, like the tin ribbing */}
      {pattern === 3 && (
        <g>
          {Array.from({ length: 13 }).map((_, i) => (
            <rect
              x={4 + i * 31}
              y={i % 2 ? 0 : 34}
              width={i % 3 === 0 ? 15 : 7}
              height={i % 2 ? 216 : 250}
              rx="3"
              fill={i % 3 === 0 ? p.alt : p.ink}
              opacity={i % 3 === 0 ? 0.9 : 0.45}
            />
          ))}
        </g>
      )}

      {/* 4 — concentric guilloche rings */}
      {pattern === 4 && (
        <g fill="none" stroke={p.ink}>
          {[22, 44, 66, 88, 110, 132, 154].map((r, i) => (
            <circle cx="312" cy="196" r={r} stroke-width={i % 2 ? 1 : 2.5} opacity={0.9 - i * 0.09} />
          ))}
          <circle cx="312" cy="196" r="14" fill={p.alt} stroke="none" />
          <path d="M0 40 H400" stroke={p.alt} stroke-width="3" opacity="0.8" />
          <path d="M0 52 H400" stroke={p.ink} stroke-width="1" opacity="0.6" />
        </g>
      )}

      {/* 6 — arched window grid, the deco panel on the tin face */}
      {pattern === 6 && (
        <g fill="none" stroke={p.ink} stroke-width="2.5">
          {[0, 1, 2, 3].map(col =>
            [0, 1].map(row => (
              <path
                d={`M ${28 + col * 96} ${104 + row * 106} L ${28 + col * 96} ${58 + row * 106} q 0 -26 26 -26 t 26 26 L ${80 + col * 96} ${104 + row * 106} Z`}
                fill={(col + row) % 2 ? p.alt : "none"}
                opacity={(col + row) % 2 ? 0.9 : 0.7}
              />
            ))
          )}
          <path d="M0 122 H400" stroke={p.alt} stroke-width="3" opacity="0.75" />
        </g>
      )}

      {/* 7 — banded label with a centred medallion */}
      {pattern === 7 && (
        <g>
          {[
            [0, 18], [26, 6], [40, 10], [200, 10], [218, 6], [232, 18],
          ].map(([y, h]) => (
            <rect x="-40" y={y} width="480" height={h} fill={p.ink} />
          ))}
          {Array.from({ length: 16 }).map((_, i) => (
            <rect x={-20 + i * 27} y="58" width="11" height="134" fill={p.ink} opacity="0.85" />
          ))}
          <rect x="132" y="52" width="136" height="146" fill={p.bg} />
          <path d="M200 62 L262 125 L200 188 L138 125 Z" fill={p.alt} stroke={p.ink} stroke-width="2.5" />
          <path d="M200 88 L238 125 L200 162 L162 125 Z" fill="none" stroke={p.ink} stroke-width="2" />
        </g>
      )}

      {/* 5 — chevron banding */}
      {pattern === 5 && (
        <g fill="none" stroke-linecap="square">
          {Array.from({ length: 9 }).map((_, i) => (
            <path
              d={`M -20 ${-40 + i * 46} L 200 ${60 + i * 46} L 420 ${-40 + i * 46}`}
              stroke={i % 3 === 0 ? p.alt : p.ink}
              stroke-width={i % 3 === 0 ? 9 : 4}
              opacity={i % 3 === 0 ? 0.95 : 0.5}
            />
          ))}
        </g>
      )}
    </g>

    {/* Gold label frame, on every cover */}
    <rect x="9" y="9" width="382" height="232" fill="none" stroke={p.frame} stroke-width="2" opacity="0.85" />
    <rect x="16" y="16" width="368" height="218" fill="none" stroke={p.frame} stroke-width="1" opacity="0.5" />
  </svg>
</div>
