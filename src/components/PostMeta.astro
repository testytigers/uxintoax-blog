---
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";

type Props = {
  date: Date;
  body: string;
  class?: string;
};

const { date, body, class: className = "" } = Astro.props;
---

<div class={`flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.6875rem] font-medium uppercase tracking-[0.12em] text-content-faint ${className}`}>
  <FormattedDate date={date} />
  <span class="diamond !size-[4px] opacity-70"></span>
  <span>{readingTime(body)}</span>
</div>
