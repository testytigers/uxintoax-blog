  <rect x="1" y="1" width="38" height="38" rx="3" fill="#080D16" stroke="#E8B33C" stroke-width="1.5" />
  <rect x="4.5" y="4.5" width="31" height="31" rx="1.5" fill="none" stroke="#E8B33C" stroke-width="0.75" opacity="0.55" />
  <path d="M11 12 L20 27 L29 12" fill="none" stroke="#E8B33C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="20" cy="31.5" r="1.6" fill="#E8B33C" />
</svg>
