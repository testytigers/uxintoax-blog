---
type Props = { href: string };
const { href } = Astro.props;
---

<a
  href={href}
  class="group inline-flex w-fit items-center gap-2 rounded-sm border border-brand/45 px-4 py-2 text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-content-muted transition-colors duration-300 hover:border-brand hover:text-brand"
>
  <svg viewBox="0 0 24 24" class="size-3.5 fill-none stroke-current stroke-2">
    <line x1="19" y1="12" x2="5" y2="12" class="origin-right scale-x-75 transition-transform duration-300 group-hover:scale-x-100" />
    <polyline points="12 5 5 12 12 19" />
  </svg>
  <slot />
</a>
