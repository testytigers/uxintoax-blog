---
import Container from "@components/Container.astro";
import SocialIcon from "@components/SocialIcon.astro";
import { SITE, SOCIALS } from "@consts";

const year = new Date().getFullYear();
const labels: Record<string, string> = {
  "twitter-x": "X",
  github: "GitHub",
  linkedin: "LinkedIn",
  dribbble: "Dribbble",
};
---

<!-- A black band, like the author strip at the bottom of the book cover -->
<footer class="overflow-hidden border-t-[6px] border-accent bg-content text-ink">
  <Container>
    <div data-reveal class="grid gap-12 pb-12 pt-16 sm:pt-20 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div class="space-y-7">
        <p class="max-w-md text-[2.2rem] font-bold leading-[1.05] tracking-[-0.035em] text-ink sm:text-5xl">
          Less noise. <span class="text-ink/50">More signal.</span>
        </p>
        <a href="/#get" data-magnetic class="btn rounded-[3px] bg-accent font-bold uppercase tracking-[0.12em] text-ink hover:bg-accent-deep">
          Get the free book
          <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-[2.5]" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <nav class="space-y-4" aria-label="Site">
        <h2 class="eyebrow text-ink/50">Explore</h2>
        <ul class="space-y-3">
          <li><a href="/" class="link-line">Home</a></li>
          <li><a href="/blog" class="link-line">All articles</a></li>
          <li><a href="/rss.xml" class="link-line">RSS feed</a></li>
        </ul>
      </nav>

      <div class="space-y-4">
        <h2 class="eyebrow text-ink/50">Contact</h2>
        <ul class="space-y-3">
          <li>
            <a href={`mailto:${SITE.EMAIL}`} class="link-line">{SITE.EMAIL}</a>
          </li>
        </ul>
        <div class="flex gap-2 pt-1">
          {SOCIALS.map(social => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={labels[social.NAME] ?? social.NAME}
              class="flex size-10 items-center justify-center rounded-full border border-ink/20 text-ink/75 transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-ink"
            >
              <SocialIcon name={social.NAME} />
            </a>
          ))}
        </div>
        <div class="pt-2">
          <button
            id="back-to-top"
            class="flex w-fit items-center gap-2 rounded-full border border-ink/20 px-4 py-2 text-sm text-ink/75 transition-colors duration-300 hover:border-ink hover:text-ink"
          >
            <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2">
              <line x1="12" y1="19" x2="12" y2="5" />
              <polyline points="5 12 12 5 19 12" />
            </svg>
            Back to top
          </button>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink/15 py-6 text-sm text-ink/55">
      <span>&copy; {year} Oussama Bougnouch</span>
      <span class="flex flex-wrap gap-5">
        <a href="https://uxintoax.com" class="link-line hover:text-ink">uxintoax.com</a>
        <a href="/privacy" class="link-line hover:text-ink">Privacy</a>
        <a href="/terms" class="link-line hover:text-ink">Terms</a>
      </span>
    </div>
  </Container>

  <div class="wordmark" aria-hidden="true">
    <span>UXintoax</span>
  </div>
</footer>

<style>
  .wordmark {
    display: flex;
    justify-content: center;
    line-height: 0.82;
    padding: 0.5rem 0 0.04em;
    font-family: var(--font-display);
    font-size: clamp(5rem, 24vw, 24rem);
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.22);
    white-space: nowrap;
    user-select: none;
  }
</style>
