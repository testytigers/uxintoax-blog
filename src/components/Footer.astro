---
import Container from "@components/Container.astro";
import SocialIcon from "@components/SocialIcon.astro";
import BackToTop from "@components/BackToTop.astro";
import { SITE, SOCIALS } from "@consts";

const year = new Date().getFullYear();
const labels: Record<string, string> = {
  "twitter-x": "X",
  github: "GitHub",
  linkedin: "LinkedIn",
  dribbble: "Dribbble",
};
---

<footer class="border-t border-line bg-ink-2">
  <Container>
    <div class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
      <div class="space-y-4">
        <div class="flex items-center gap-2.5">
          <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true">
            <rect x="1.5" y="1.5" width="29" height="29" rx="8" fill="none" stroke="#55b48e" stroke-width="2" />
            <path d="M9 9 L16 22 L23 9" fill="none" stroke="#55b48e" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="text-base font-bold tracking-tight text-content">UX Architect</span>
        </div>
        <p class="max-w-sm font-serif leading-relaxed text-content-muted">
          Practical strategies, processes and tools for UX designers navigating the AI revolution.
        </p>
        <div class="flex gap-2 pt-1">
          {SOCIALS.map(social => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={labels[social.NAME] ?? social.NAME}
              class="flex size-10 items-center justify-center rounded-full border border-line text-content-muted transition-colors duration-200 hover:border-brand hover:text-brand"
            >
              <SocialIcon name={social.NAME} />
            </a>
          ))}
        </div>
      </div>

      <nav class="space-y-3" aria-label="Site">
        <h2 class="eyebrow">Explore</h2>
        <ul class="space-y-2.5 text-content-muted">
          <li><a href="/" class="transition-colors hover:text-brand">Home</a></li>
          <li><a href="/blog" class="transition-colors hover:text-brand">All articles</a></li>
          <li><a href="/rss.xml" class="transition-colors hover:text-brand">RSS feed</a></li>
        </ul>
      </nav>

      <div class="space-y-3">
        <h2 class="eyebrow">Contact</h2>
        <ul class="space-y-2.5 text-content-muted">
          <li>
            <a href={`mailto:${SITE.EMAIL}`} class="transition-colors hover:text-brand">
              {SITE.EMAIL}
            </a>
          </li>
        </ul>
        <div class="pt-2">
          <BackToTop />
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line py-6 text-sm text-content-faint">
      <span>&copy; {year} {SITE.NAME}</span>
      <span>Built with Astro</span>
    </div>
  </Container>
</footer>
