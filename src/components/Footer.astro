---
import Container from "@components/Container.astro";
import SocialIcon from "@components/SocialIcon.astro";
import BackToTop from "@components/BackToTop.astro";
import Wordmark from "@components/Wordmark.astro";
import { SITE, SOCIALS } from "@consts";

const year = new Date().getFullYear();
const labels: Record<string, string> = {
  "twitter-x": "X",
  github: "GitHub",
  linkedin: "LinkedIn",
  dribbble: "Dribbble",
};
---

<footer class="bg-ink-2">
  <div class="h-px w-full bg-brand/45"></div>
  <div class="mt-[2px] h-px w-full bg-brand/20"></div>

  <Container>
    <div class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <Wordmark class="size-8" />
          <span class="font-serif text-lg font-semibold tracking-tight text-content">UXintoax</span>
        </div>
        <p class="max-w-sm font-serif leading-relaxed text-content-muted">
          Practical UX design strategies and AI integration guides for modern designers.
        </p>
        <div class="flex gap-2 pt-1">
          {SOCIALS.map(social => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={labels[social.NAME] ?? social.NAME}
              class="flex size-10 items-center justify-center rounded-sm border border-brand/35 text-content-muted transition-colors duration-200 hover:border-brand hover:bg-brand hover:text-brand-ink"
            >
              <SocialIcon name={social.NAME} />
            </a>
          ))}
        </div>
      </div>

      <nav class="space-y-4" aria-label="Site">
        <h2 class="eyebrow">Explore</h2>
        <ul class="space-y-2.5 text-content-muted">
          <li><a href="/" class="transition-colors hover:text-brand">Home</a></li>
          <li><a href="/blog" class="transition-colors hover:text-brand">All articles</a></li>
          <li><a href="/rss.xml" class="transition-colors hover:text-brand">RSS feed</a></li>
        </ul>
      </nav>

      <div class="space-y-4">
        <h2 class="eyebrow">Contact</h2>
        <ul class="space-y-2.5 text-content-muted">
          <li>
            <a href={`mailto:${SITE.EMAIL}`} class="transition-colors hover:text-brand">
              {SITE.EMAIL}
            </a>
          </li>
        </ul>
        <div class="pt-2">
          <BackToTop />
        </div>
      </div>
    </div>

    <div class="deco-rule py-1">
      <span class="diamond"></span>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 py-6 text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-content-faint">
      <span>&copy; {year} {SITE.NAME}</span>
      <span>Built with Astro</span>
    </div>
  </Container>
</footer>
