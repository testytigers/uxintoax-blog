---
import Container from "@components/Container.astro";
import SocialIcon from "@components/SocialIcon.astro";
import { SITE, SOCIALS, BOOK_PATH } from "@consts";

const year = new Date().getFullYear();
const labels: Record<string, string> = {
  "twitter-x": "X",
  github: "GitHub",
  linkedin: "LinkedIn",
  dribbble: "Dribbble",
};
---

<!-- A black band, like the author strip at the bottom of the book cover -->
<footer class="overflow-hidden border-t-[6px] border-accent bg-content text-ink">
  <Container>
    <div data-reveal class="grid gap-12 pb-12 pt-16 sm:pt-20 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div class="space-y-7">
        <p class="max-w-md text-[2.2rem] font-bold leading-[1.05] tracking-[-0.035em] text-ink sm:text-5xl">
          Less noise. <span class="text-ink/50">More signal.</span>
        </p>
        <a href={`${BOOK_PATH}#get`} data-magnetic class="btn rounded-[3px] bg-accent font-bold uppercase tracking-[0.12em] text-ink hover:bg-accent-deep">
          Get the free book
          <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-[2.5]" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <nav class="space-y-4" aria-label="Site">
        <h2 class="eyebrow text-ink/50">Explore</h2>
        <ul class="space-y-3">
          <li><a href="/" class="link-line">Home</a></li>
          <li><a href="/blog" class="link-line">All articles</a></li>
          <li><a href={BOOK_PATH} class="link-line">Signal vs Noise, the book</a></li>
          <li><a href="/#subscribe" class="link-line">Newsletter</a></li>
          <li><a href="/rss.xml" class="link-line">RSS feed</a></li>
        </ul>
      </nav>

      <div class="space-y-4">
        <h2 class="eyebrow text-ink/50">Contact</h2>
        <ul class="space-y-3">
          <li>
            <a href={`mailto:${SITE.EMAIL}`} class="link-line">{SITE.EMAIL}</a>
          </li>
        </ul>
        <div class="flex gap-2 pt-1">
          {SOCIALS.map(social => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={labels[social.NAME] ?? social.NAME}
              class="flex size-10 items-center justify-center rounded-full border border-ink/20 text-ink/75 transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-ink"
            >
              <SocialIcon name={social.NAME} />
            </a>
          ))}
        </div>
        <div class="pt-2">
          <button
            id="back-to-top"
            class="flex w-fit items-center gap-2 rounded-full border border-ink/20 px-4 py-2 text-sm text-ink/75 transition-colors duration-300 hover:border-ink hover:text-ink"
          >
            <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2">
              <line x1="12" y1="19" x2="12" y2="5" />
              <polyline points="5 12 12 5 19 12" />
            </svg>
            Back to top
          </button>
        </div>
      </div>
    </div>


    <!-- Wordmark sized to the container. Green liquid rises inside the letters on scroll. -->
    <div class="wordmark" aria-hidden="true" data-liquid>
      <svg viewBox="8.35 39.8 1047.8 262.6" preserveAspectRatio="xMidYMid meet" focusable="false">
        <defs>
          <!-- Satin: diagonal folds of deep, royal and bright greens, reflected so they repeat softly -->
          <linearGradient id="liquid-fill" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1060" y2="300" spreadMethod="reflect">
            <stop offset="0" class="s1" />
            <stop offset="0.14" class="s2" />
            <stop offset="0.3" class="s3" />
            <stop offset="0.42" class="s4" />
            <stop offset="0.58" class="s5" />
            <stop offset="0.7" class="s6" />
            <stop offset="0.84" class="s7" />
            <stop offset="1" class="s8" />
          </linearGradient>
          <!-- A band of light that slides across the satin -->
          <linearGradient id="liquid-sheen" gradientUnits="userSpaceOnUse" x1="-420" y1="0" x2="0" y2="160">
            <stop offset="0" stop-color="#fff" stop-opacity="0" />
            <stop offset="0.5" stop-color="#eaffdf" stop-opacity="0.16" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
            <animateTransform attributeName="gradientTransform" type="translate" values="-200 0; 1500 0" dur="6.5s" repeatCount="indefinite" />
          </linearGradient>
          <clipPath id="wordmark-clip">
            <text x="0" y="300">UXINTOAX</text>
          </clipPath>
        </defs>
        <g clip-path="url(#wordmark-clip)">
          <g data-liquid-level transform="translate(0 20)">
            <path class="wave wave-back" d="M -262 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 V 340 H -262 Z" />
            <path class="wave wave-front" d="M -262 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 V 340 H -262 Z" />
            <path class="wave wave-sheen" d="M -262 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 q 65.5 -10 131.0 0 t 131.0 0 V 340 H -262 Z" />
          </g>
        </g>
        <text class="wm-stroke" x="0" y="300">UXINTOAX</text>
      </svg>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink/15 py-6 text-sm text-ink/55">
      <span>&copy; {year} Oussama Bougnouch</span>
      <span class="flex flex-wrap gap-5">
        <a href="https://uxintoax.com" class="link-line hover:text-ink">uxintoax.com</a>
        <a href="/privacy" class="link-line hover:text-ink">Privacy</a>
        <a href="/terms" class="link-line hover:text-ink">Terms</a>
      </span>
    </div>
  </Container>

</footer>

<style>
  .wordmark {
    padding: 2rem 0 1.5rem;
    user-select: none;
  }

  .wordmark svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .wordmark text {
    font-family: var(--font-display);
    font-size: 300px;
    text-transform: uppercase;
  }

  .wm-stroke {
    fill: none;
    stroke: rgb(255 255 255 / 0.28);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .s1 { stop-color: var(--satin-1); }
  .s2 { stop-color: var(--satin-2); }
  .s3 { stop-color: var(--satin-3); }
  .s4 { stop-color: var(--satin-4); }
  .s5 { stop-color: var(--satin-5); }
  .s6 { stop-color: var(--satin-6); }
  .s7 { stop-color: var(--satin-7); }
  .s8 { stop-color: var(--satin-8); }

  .wave {
    fill: url(#liquid-fill);
    animation: wave-drift 7s linear infinite;
  }

  .wave-back {
    opacity: 0.45;
    animation-duration: 11s;
    animation-direction: reverse;
    translate: -131px 6px;
  }

  .wave-sheen {
    fill: url(#liquid-sheen);
    mix-blend-mode: soft-light;
  }

  @keyframes wave-drift {
    to {
      transform: translateX(-262px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }

    .wave-sheen {
      display: none;
    }
  }
</style>
