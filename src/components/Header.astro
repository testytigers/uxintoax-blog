---
import Container from "@components/Container.astro";

const path = Astro.url.pathname;
const nav = [
  { href: "/#chapters", label: "Book" },
  { href: "/#why", label: "Why" },
  { href: "/blog", label: "Articles" },
  { href: "/#about", label: "About" },
];
const isActive = (href: string) => href.startsWith("/blog") && path.startsWith("/blog");
---

<!-- A black band, like the strip across the top of the book cover -->
<header data-site-header class="site-header sticky top-0 z-50 bg-content text-ink">
  <Container>
    <div class="flex h-16 items-center justify-between gap-4 sm:h-[4.5rem]">
      <a href="/" class="group flex items-center gap-3" aria-label="Oussama Bougnouch, home">
        <img
          src="/assets/author.jpg"
          width="72"
          height="72"
          alt=""
          class="size-9 shrink-0 rotate-[10deg] rounded-[3px] object-cover grayscale transition-all duration-500 group-hover:rotate-0 group-hover:grayscale-0 sm:size-10"
        />
        <span class="leading-none">
          <span class="block text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-ink/55">by</span>
          <span class="mt-1 block whitespace-nowrap font-display text-[1.05rem] uppercase tracking-[0.06em] sm:text-[1.2rem]">
            Oussama Bougnouch
          </span>
        </span>
      </a>

      <nav class="flex items-center gap-1 sm:gap-7" aria-label="Main">
        {nav.map(item => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="link-line hidden py-1 text-[0.78rem] font-bold uppercase tracking-[0.16em] text-ink/85 transition-colors hover:text-ink aria-[current=page]:text-ink sm:block"
          >
            {item.label}
          </a>
        ))}
        <a
          href="/#get"
          data-magnetic
          class="ml-2 inline-flex items-center gap-2 whitespace-nowrap rounded-[3px] bg-accent px-4 py-2.5 text-xs font-bold uppercase tracking-[0.12em] text-ink transition-colors duration-300 hover:bg-accent-deep sm:text-[0.78rem]"
        >
          Get the book
          <svg viewBox="0 0 24 24" class="hidden size-3.5 fill-none stroke-current stroke-[2.5] sm:block" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </nav>
    </div>
  </Container>
</header>

<style>
  .site-header {
    view-transition-name: site-header;
    transition: transform 0.6s var(--ease-out);
  }

  .site-header:global(.is-hidden) {
    transform: translateY(-100%);
  }
</style>
