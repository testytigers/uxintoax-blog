---
import Container from "@components/Container.astro";

const path = Astro.url.pathname;
const nav = [
  { href: "/#chapters", label: "Book" },
  { href: "/#why", label: "Why" },
  { href: "/blog", label: "Articles" },
  { href: "/#about", label: "About" },
];
const isActive = (href: string) => href.startsWith("/blog") && path.startsWith("/blog");
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/90 backdrop-blur-md">
  <Container>
    <div class="flex h-16 items-center justify-between gap-4 sm:h-[4.6rem]">
      <a href="/" class="flex items-center gap-2.5" aria-label="Oussama Bougnouch, home">
        <span
          class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand text-xs font-bold tracking-tight text-brand-ink sm:size-10"
          aria-hidden="true"
        >
          OB
        </span>
        <span class="leading-tight">
          <span class="block text-[0.7rem] font-medium text-content-faint">by</span>
          <span class="block text-sm font-bold tracking-tight text-content sm:text-[0.95rem]">
            OUSSAMA BOUGNOUCH
          </span>
        </span>
      </a>

      <nav class="flex items-center gap-1 sm:gap-2" aria-label="Main">
        {nav.map(item => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={`hidden rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wide transition-colors duration-200 sm:block ${
              isActive(item.href)
                ? "bg-mint text-brand-deep"
                : "text-content hover:text-brand"
            }`}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/#get"
          class="rounded px-3.5 py-2 text-xs font-semibold text-brand-ink transition-colors duration-200 bg-brand hover:bg-brand-deep sm:text-sm"
        >
          Get the book
        </a>
      </nav>
    </div>
  </Container>
</header>
