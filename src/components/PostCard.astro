---
import type { CollectionEntry } from "astro:content";
import Cover from "@components/Cover.astro";
import PostMeta from "@components/PostMeta.astro";

type Props = {
  entry: CollectionEntry<"blog">;
  variant?: "featured" | "grid" | "row";
};

const { entry, variant = "grid" } = Astro.props;
const featured = variant === "featured";
const tag = entry.data.tags?.[0];

// The featured cover grows to absorb any extra column height,
// so the card never ends up with a dead gap under its text.
const coverWrap = featured ? "relative flex-1 min-h-[240px]" : "relative";
const coverClass = {
  featured: "h-full w-full",
  grid: "aspect-[3/2] w-full",
  row: "aspect-[16/9] w-full",
}[variant];

const titleSize = {
  featured: "text-2xl sm:text-3xl lg:text-[2.05rem] leading-[1.12]",
  grid: "text-xl leading-snug",
  row: "text-lg leading-snug",
}[variant];
---

<article class="group h-full">
  <a
    href={`/blog/${entry.slug}`}
    class="plate flex h-full flex-col overflow-hidden transition-colors duration-300 hover:bg-surface-hover"
  >
    <div class={coverWrap}>
      <Cover seed={entry.slug} class={coverClass} />
      <!-- gold band separating the label art from the type block -->
      <div class="absolute inset-x-0 bottom-0 h-[3px] bg-brand/70"></div>
    </div>

    <div class={`relative flex flex-col gap-3 p-5 sm:p-6 ${featured ? "shrink-0" : "flex-1"}`}>
      {tag && <span class="badge w-fit">{tag}</span>}

      <h3 class={`font-serif font-semibold tracking-tight text-content transition-colors duration-300 group-hover:text-brand ${titleSize}`}>
        {entry.data.title}
      </h3>

      {featured && (
        <p class="max-w-2xl font-serif text-base leading-relaxed text-content-muted">
          {entry.data.description}
        </p>
      )}

      <div class={featured ? "pt-1" : "mt-auto pt-2"}>
        <div class="mb-3 h-px w-full bg-brand/20"></div>
        <PostMeta date={entry.data.date} body={entry.body} />
      </div>
    </div>
  </a>
</article>
