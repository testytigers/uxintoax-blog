---
/**
 * A real six-sided CSS 3D book. All faces derive from --bw (book width),
 * so resizing the book is a single custom property. Animation lives in
 * src/scripts/book.ts.
 */
type Props = { class?: string };
const { class: className = "" } = Astro.props;
---

<div class={`book3d ${className}`} data-book role="img" aria-label="Signal vs Noise, the book. Cover: a hand reaching up through a red and cream burst to hold one green apple among dozens of dark, rotting apples.">
  <div class="book-stage">
    <div class="book-scroll">
      <div class="book-turn">
        <div class="book-float">
          <div class="book-tilt">
            <div class="book">
              <div class="face front">
                <img
                  src="/assets/signal-noise-cover-650.jpg"
                  srcset="/assets/signal-noise-cover-650.jpg 433w, /assets/signal-noise-cover-900.jpg 900w"
                  sizes="(max-width: 640px) 60vw, 340px"
                  width="433"
                  height="650"
                  alt=""
                  fetchpriority="high"
                  decoding="async"
                  draggable="false"
                />
                <span class="hinge"></span>
                <span class="book-sheen"></span>
              </div>

              <div class="face back">
                <span class="back-kicker">AI guide for UX designers</span>
                <p class="back-quote">Everyone is handing you rotten AI advice. <span>This is the one worth taking.</span></p>
                <span class="back-meta">Eleven chapters<br />uxintoax.com</span>
              </div>

              <div class="face spine">
                <span class="spine-title">Signal vs Noise</span>
                <span class="spine-author">Bougnouch</span>
              </div>

              <div class="face pages"></div>
              <div class="face top"></div>
              <div class="face bottom"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="book-shadow-wrap" aria-hidden="true"><div class="book-shadow"></div></div>
</div>

<style>
  .book3d {
    --bw: 320px;
    --bh: calc(var(--bw) * 1.496);
    --bd: calc(var(--bw) * 0.095);
    position: relative;
    width: var(--bw);
    height: var(--bh);
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .book-stage {
    position: absolute;
    inset: 0;
    perspective: 1800px;
    perspective-origin: 50% 40%;
  }

  .book-scroll,
  .book-turn,
  .book-float,
  .book-tilt,
  .book {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .book {
    transform: rotateY(24deg) rotateX(4deg) rotateZ(-1deg);
  }

  .face {
    position: absolute;
    left: 50%;
    top: 50%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Front and back covers */
  .front,
  .back {
    width: var(--bw);
    height: var(--bh);
    margin: calc(var(--bh) / -2) 0 0 calc(var(--bw) / -2);
    border-radius: 2px 5px 5px 2px;
    overflow: hidden;
  }

  .front {
    transform: translateZ(calc(var(--bd) / 2));
    background: #0f0f0e;
  }

  .front img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* The crease where a paperback cover folds into the spine */
  .hinge {
    position: absolute;
    inset: 0 auto 0 0;
    width: 9%;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.12) 22%,
      rgba(255, 255, 255, 0.22) 34%,
      rgba(255, 255, 255, 0) 48%,
      rgba(0, 0, 0, 0.08) 100%
    );
    pointer-events: none;
  }

  .book-sheen {
    position: absolute;
    inset: -10% -60%;
    background: linear-gradient(
      105deg,
      rgba(255, 255, 255, 0) 38%,
      rgba(255, 255, 255, 0.28) 50%,
      rgba(255, 255, 255, 0) 62%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .back {
    transform: rotateY(180deg) translateZ(calc(var(--bd) / 2));
    background: #0d0c0a;
    color: #f5ead2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--bw) * 0.1);
  }

  .back-kicker,
  .back-meta {
    font-size: calc(var(--bw) * 0.032);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.7;
    color: rgba(245, 234, 210, 0.6);
  }

  .back-quote {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: calc(var(--bw) * 0.092);
    line-height: 1.02;
    color: #f5ead2;
  }

  .back-quote span {
    color: rgba(245, 234, 210, 0.55);
  }

  /* Spine */
  .spine {
    width: var(--bd);
    height: var(--bh);
    margin: calc(var(--bh) / -2) 0 0 calc(var(--bd) / -2);
    transform: rotateY(-90deg) translateZ(calc(var(--bw) / 2));
    background: linear-gradient(90deg, #050505, #1c1c1a 45%, #0a0a0a);
    color: #f5ead2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    writing-mode: vertical-rl;
    padding: calc(var(--bw) * 0.07) 0;
    border-radius: 3px 0 0 3px;
  }

  .spine-title {
    font-family: var(--font-display);
    font-size: calc(var(--bd) * 0.5);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .spine-author {
    font-weight: 600;
    font-size: calc(var(--bd) * 0.3);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 234, 210, 0.55);
    white-space: nowrap;
  }

  /* Page block */
  .pages {
    width: var(--bd);
    height: calc(var(--bh) - 6px);
    margin: calc((var(--bh) - 6px) / -2) 0 0 calc(var(--bd) / -2);
    transform: rotateY(90deg) translateZ(calc(var(--bw) / 2 - 3px));
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 0.12)),
      repeating-linear-gradient(90deg, #fbf8ef 0 1px, #e3dccb 1px 2px);
  }

  .top,
  .bottom {
    width: calc(var(--bw) - 3px);
    height: var(--bd);
    margin: calc(var(--bd) / -2) 0 0 calc((var(--bw) - 3px) / -2);
    background: repeating-linear-gradient(0deg, #fbf8ef 0 1px, #e3dccb 1px 2px);
  }

  .top {
    transform: rotateX(90deg) translateZ(calc(var(--bh) / 2 - 3px));
  }

  .bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--bh) / 2 - 3px));
  }

  /* Ground shadow */
  .book-shadow-wrap {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: calc(var(--bh) * -0.12);
    height: calc(var(--bw) * 0.14);
    pointer-events: none;
  }

  .book-shadow {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(13, 12, 10, 0.4), rgba(13, 12, 10, 0));
    filter: blur(6px);
  }

  @media (max-width: 640px) {
    .book3d {
      --bw: min(56vw, 230px);
    }
  }
</style>
